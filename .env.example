# Placeholders to replace after importing the workflow into n8n.
# n8n does not read this file. It is a checklist of values that were removed before publishing.

# Telegram chat that receives drafts (node: Telegram: draft to manager)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Zoho data centre. Change it in three HTTP nodes if you are not on .com:
#   https://www.zohoapis.com/crm/v2  →  https://www.zohoapis.eu/crm/v2 (EU), .in, .com.au ...
ZOHO_API_BASE=https://www.zohoapis.com/crm/v2
# Web UI link inside the Telegram message (const ZOHO_UI in Pick leads due for a touch)
ZOHO_UI=https://crm.zoho.com

# Schedule (node: Weekdays 9:00), uses the n8n instance timezone
CRON=0 9 * * 1-5

# Credentials to connect in n8n (not stored in the JSON):
#   Zoho OAuth2, Anthropic API, Telegram Bot API
